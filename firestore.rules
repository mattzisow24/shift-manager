rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per team, addressed by the team code. There are no
    // accounts: knowing the code (= the document id) is what grants access.
    // Listing the collection is denied so codes can't be discovered, and
    // documents can't be deleted from the app.
    match /teams/{teamId} {
      allow get, create, update: if true;
      allow list, delete: if false;
    }
  }
}
